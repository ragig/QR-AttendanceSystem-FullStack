# Copy this file to .env and edit.  .env is never committed.

# Development: True.  Production: False (and set a real secret key below).
DJANGO_DEBUG=True

# Generate one with:  python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string

# Hosts Django will answer to (comma separated). Add your LAN IP if the phone
# talks to Django directly (not through the Vite proxy).
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# Only needed when the React app calls Django directly (VITE_API_URL=http://127.0.0.1:8000/api).
# With the Vite dev proxy (/api) the browser never makes a cross-origin call.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Address of the React app. Used to build the session-QR link: <FRONTEND_URL>/?attendance=<token>
# Use your computer's LAN IP if phones scan session QR codes, e.g. http://192.168.1.10:5173
FRONTEND_URL=http://localhost:5173

DJANGO_TIME_ZONE=Asia/Kolkata

# Login lifetime of the JWT (hours) and of a token created by scanning a personal QR (minutes).
JWT_ACCESS_HOURS=12
QR_LOGIN_MINUTES=30
